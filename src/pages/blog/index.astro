---
// /blog ya no es una página propia: el índice vive en la portada.
// Redirección standalone (sin layout) a "/" para no duplicar contenido.
const home = new URL('/', Astro.site).href;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<title>Redirigiendo… · abulia terminal</title>
		<meta name="robots" content="noindex, follow" />
		<link rel="canonical" href={home} />
		<meta http-equiv="refresh" content="0; url=/" />
	</head>
	<body>
		<p>El índice de textos está en la portada. <a href="/">Ir a abulia terminal</a>.</p>
	</body>
</html>
