// Redirección standalone (sin layout) a esa página.
const target = new URL('/nosotros', Astro.site).href;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<title>Redirigiendo… · abulia terminal</title>
		<meta name="robots" content="noindex, follow" />
		<link rel="canonical" href={target} />
		<meta http-equiv="refresh" content="0; url=/nosotros" />
	</head>
	<body>
		<p>Esta página se movió. <a href="/nosotros">Conoce abulia terminal en Nosotros</a>.</p>
	</body>
</html>
